/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows (runs locally; replace /path/to/5baseTAPS with your clone location):
        module load singularity
        nextflow run /path/to/5baseTAPS -profile test,sumner2_apptainer --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input  = "https://raw.githubusercontent.com/tjongh/5baseTAPS-test-data/main/samplesheet_tiny.csv"
}

validation {
    defaultIgnoreParams = ['genomes']
}

