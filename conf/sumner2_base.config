/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sumner2 HPC base configuration — SLURM + Singularity settings shared by
    sumner2_singularity and sumner_test profiles.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params.igenomes_ignore = true
params.rastair_mbias_mem_base = 300
params.rastair_mbias_mem_step = 100

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/projects/omics_share/meta/containers'
    runOptions = '-B /flashscratch:/flashscratch --bind /projects:/projects'
}

process {
    executor      = 'slurm'
    queue         = 'compute'
    clusterOptions = {task.time < 72.h ? '-q batch' : '-q long'}
    memory        = '16 GB'
    cpus          = 4
    time          = '18h'
}

executor {
    name            = 'slurm'
    queueSize       = 150
    submitRateLimit = '1 / 2 s'
}
