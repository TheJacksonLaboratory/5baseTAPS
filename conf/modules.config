/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: 'BWA_INDEX|BWAMEM2_INDEX' {
        ext.when  = { !params.bwamem2 }
        memory    = { 96.GB * task.attempt }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SAMTOOLS_FAIDX {
        ext.when = { !params.fasta_fai }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SAMTOOLS_DICT {
        ext.when = { !params.dict }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: FASTQC {
        cpus = { 4 * task.attempt }
        memory = { 4.GB * task.attempt }
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/fastqc" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,zip}",
        ]
    }

    withName: 'CONCAT_FASTQ_R1|CONCAT_FASTQ_R2' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 24.h * task.attempt }
        publishDir = [ enabled: false ]
    }
    withName: CONCAT_FASTQ_R1 {
        ext.prefix = { "${meta.id}_R1" }
    }
    withName: CONCAT_FASTQ_R2 {
        ext.prefix = { "${meta.id}_R2" }
    }

    withName: FASTQTOBAM {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    // Split-align-merge — SPLIT_FASTQ, FASTQTOBAM_CHUNK, ALIGN_RAW_CHUNK, MERGE_CHUNKS
    withName: SPLIT_FASTQ {
        cpus   = { (((params.align_raw_bam_chunks as Integer) ?: 4) * 2 + 4) * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: FASTQTOBAM_CHUNK {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
        ext.prefix = { "${meta.id}.lane${meta.lane}.chunk_${meta.chunk}" }
        publishDir = [ enabled: false ]
    }

    withName: ALIGN_RAW_CHUNK {
        cpus                 = { 16 * task.attempt }
        memory               = { 48.GB * task.attempt }
        time                 = { 8.h * task.attempt }
        ext.samtools_threads = 2
        ext.bwa_cpu_reserve  = 4
        ext.prefix           = { "${meta.id}.lane${meta.lane}.chunk_${meta.chunk}" }
        publishDir           = [ enabled: false ]
    }

    withName: MERGE_CHUNKS {
        cpus   = { 16 * task.attempt }
        memory = { 192.GB * task.attempt }
        time   = { 2.h * task.attempt }
        ext.sort_mem = '8G'
        ext.prefix   = { "${meta.id}.lane${meta.lane}" }
        publishDir = [ enabled: false ]
    }

    withName: 'ALIGN_RAW_BAM|ALIGN_CONS' {
        cpus                       = { 44 * task.attempt }
        memory                     = { 96.GB * task.attempt }
        ext.samtools_threads       = 4
        ext.samtools_sort_threads  = 6
        ext.bwa_cpu_reserve        = 14
        ext.samtools_sort_mem      = '8G'
    }

    withName: ALIGN_RAW_BAM {
        publishDir = [ enabled: false ]
    }

    withName: MERGE_BAM {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
        ext.args = '--template-coordinate'
        publishDir = [ enabled: false ]
    }

    withName: GROUP_UMI {
        cpus   = { 4 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 16.h * task.attempt }
        publishDir = [
            [
                enabled: false,
                path: { "${params.outdir}/${meta.id}/qc/duplex" },
                mode: params.publish_dir_mode,
                pattern: '*.grouped.bam',
            ],
            [
                path: { "${params.outdir}/${meta.id}/qc/duplex" },
                mode: params.publish_dir_mode,
                pattern: '*.grouped-family-sizes.txt',
            ],
        ]
    }

    withName: DUPLEX_QC {
        cpus   = 2
        memory = { 96.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/duplex" },
            mode: params.publish_dir_mode,
            pattern: '*duplex_seq_metrics*.{txt,pdf}',
        ]
    }

    withName: 'CALL_DUPLEX|CALLMOLECULARCONSENSUSREADS' {
        cpus   = { 16 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'CALLANDFILTERDUPLEXCONSENSUSREADS|CALLANDFILTERMOLECULARCONSENSUSREADS|CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/bam" },
            mode: params.publish_dir_mode,
            pattern: '*.cons.filtered.{bam,bam.bai}',
        ]
    }

    withName: CONSENSUS {
        cpus               = { 8 * task.attempt }
        memory             = { 96.GB * task.attempt }
        time               = { 12.h * task.attempt }
        ext.fgbio_mem_gb   = 32
        ext.samtools_threads = 5
        ext.samtools_args  = '-m 5G'
    }

    withName: ALIGN_CONS {
        cpus                  = { 27 * task.attempt }
        memory                = { 80.GB * task.attempt }
        ext.bwa_cpu_reserve   = 11
        ext.samtools_sort_mem = '4G'
        publishDir = [ enabled: false ]
    }

    withName: PERREAD {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.rastair_perread.bed.gz",
        ]
    }

    withName: TABIX_TABIX {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.tbi",
        ]
    }

    withName: RASTAIR_CALL {
        cpus   = { 25 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 16.h * task.attempt }
        ext.threads = 24
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/methylation" },
                mode: params.publish_dir_mode,
                pattern: "*.rastair_call.bed.gz",
            ],
            [
                path: { "${params.outdir}/${meta.id}/methylation" },
                mode: params.publish_dir_mode,
                pattern: "*.rastair_call.vcf.gz",
            ],
        ]
    }

    withName: GET_CHRS {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 1.h  * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: MBIAS_CHR {
        cpus   = 2
        memory = { 80.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: RENDER {
        cpus   = 2
        memory = { 64.GB * task.attempt }
        time   = { 3.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.rastair_mbias.html",
        ]
    }

    withName: METH_SUMMARY {
        // Default: global ALL row + per-chromosome rows.
        // To suppress per-chromosome rows (global ALL only): ext.args = '--all-cpgs'
        // --all-cpgs: BED from RASTAIR_CALL_ALLCPG (--cpgs-only --all) enables breadth columns.
        ext.args = '--per-chr --all-cpgs'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.methylation_summary.tsv",
        ]
    }

    withName: METHYLKIT {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.txt.gz",
        ]
    }

    withName: CPG_MASK {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: "*.rastair_cpg_sites.bed.gz{,.tbi}",
        ]
    }

    // ── Control genome methylation QC (lambda + pUC19 spike-ins) ─────────────

    withName: 'LAMBDA_ALIGN_RAW_BAM|LAMBDA_ALIGN_CONS|PUC19_ALIGN_RAW_BAM|PUC19_ALIGN_CONS' {
        cpus                 = { 12 * task.attempt }
        memory               = { 4.GB * task.cpus }
        ext.samtools_threads = 2
        ext.bwa_cpu_reserve  = 6
        ext.filter_unmapped  = true
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_ALIGN_RAW_BAM|LAMBDA_ALIGN_CONS' {
        ext.prefix = { meta.containsKey('lane') ? "${meta.id}.lane${meta.lane}.lambda_negCtrl" : "${meta.id}.lambda_negCtrl" }
    }

    withName: 'PUC19_ALIGN_RAW_BAM|PUC19_ALIGN_CONS' {
        ext.prefix = { meta.containsKey('lane') ? "${meta.id}.lane${meta.lane}.puc19_posCtrl" : "${meta.id}.puc19_posCtrl" }
    }

    withName: 'LAMBDA_ALIGN_CONS|PUC19_ALIGN_CONS' {
        cpus                     = { 6 * task.attempt }
        memory                   = { 16.GB * task.attempt }
        ext.bwa_cpu_reserve      = 4
        ext.samtools_sort_threads = 1
    }

    withName: 'LAMBDA_MERGE_BAM|PUC19_MERGE_BAM' {
        ext.args   = '--template-coordinate'
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_GROUP_UMI|PUC19_GROUP_UMI' {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_CALL_DUPLEX|LAMBDA_CALLMOLECULARCONSENSUSREADS|PUC19_CALL_DUPLEX|PUC19_CALLMOLECULARCONSENSUSREADS' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_CONSENSUS|PUC19_CONSENSUS' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_RASTAIR_CALL|PUC19_RASTAIR_CALL' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_METH_SUMMARY' {
        ext.args   = '--per-chr'
        ext.prefix = { "${meta.id}.lambda_negCtrl" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.methylation_summary.tsv",
        ]
    }

    withName: 'PUC19_METH_SUMMARY' {
        ext.args   = '--per-chr'
        ext.prefix = { "${meta.id}.puc19_posCtrl" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.methylation_summary.tsv",
        ]
    }

    withName: GATK4_COMPOSESTRTABLEFILE {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: GATK4_CALIBRATEDRAGSTRMODEL {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/variant_call" },
            mode: params.publish_dir_mode,
            pattern: "*.dragstr_model.txt",
        ]
    }

    withName: EXTRACT_MAJOR_CHROMS {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 10.min * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: GATK4_HAPLOTYPECALLER {
        cpus   = { 6 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 24.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: GATK4_MERGEVCFS {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        ext.args = '--COMMENT "Merged from scattered per-chromosome HaplotypeCaller runs (chr1-22,X,Y); surviving GATKCommandLine entry is representative of parameters used for all 24 per-chrom runs"'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf.gz{,.tbi}",
        ]
    }

    withName: GATK4_VARIANTFILTRATION {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
        ext.prefix = { "${meta.id}.haplotypecaller" }
        // ext.args = [
        //     '--filter-expression "FS > 60.0 || SOR > 3.0" --filter-name "StrandBias"',
        //     '--filter-expression "ReadPosRankSum < -8.0"  --filter-name "ReadPos"',
        //     '--filter-expression "MQ < 40.0"              --filter-name "LowMQ"',
        //     '--filter-expression "MQRankSum < -12.5"      --filter-name "MQRankSum"',
        // ].join(' ')
        publishDir = [ enabled: false ]
    }

    withName: BCFTOOLS_SPLITVCF {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}.haplotypecaller" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf.gz{,.tbi}",
        ]
    }

    // ── Phase 1 QC metrics ───────────────────────────────────────────────────

    withName: METHYL_QC {
        cpus       = 1
        memory     = { 2.GB * task.attempt }
        time       = { 30.m * task.attempt }
        ext.genome = { params.genome ?: "Sample" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: 'SAMTOOLS_FLAGSTAT|LAMBDA_SAMTOOLS_FLAGSTAT|PUC19_SAMTOOLS_FLAGSTAT' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat",
        ]
    }

    withName: SAMTOOLS_FLAGSTAT {
        ext.prefix = { "${meta.id}.rawlane" }
        publishDir = [ enabled: false ]
    }

    withName: LAMBDA_SAMTOOLS_FLAGSTAT {
        ext.prefix = { "${meta.id}.lambda_negCtrl" }
    }

    withName: PUC19_SAMTOOLS_FLAGSTAT {
        ext.prefix = { "${meta.id}.puc19_posCtrl" }
    }

    withName: BCFTOOLS_STATS {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/variant_call" },
            mode: params.publish_dir_mode,
            pattern: "*.bcftools_stats.txt",
        ]
    }

    // ── Phase 1 QC: post-dedup flagstat, mosdepth, per-sample metric CSVs ───────

    withName: PREDEDUP_FLAGSTAT {
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}.prededup" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat",
        ]
    }

    withName: POSTDEDUP_FLAGSTAT {
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}.postdedup" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat",
        ]
    }

    withName: SAMTOOLS_STATS {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.cons.stats",
        ]
    }

    withName: MOSDEPTH {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/coverage" },
            mode: params.publish_dir_mode,
            pattern: "*.mosdepth.{summary,global.dist}.txt",
        ]
    }

    withName: ALIGN_QC {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: DUPLEX_MQC {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: WGS_QC {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: TAPS_VC_METRICS {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: TAPS_QC_REPORT {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            pattern: "taps_qc_report.{html,tsv}",
        ]
    }

    withName: 'TAPS_MULTIQC' {
        cpus   = { 4 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
