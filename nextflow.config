/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TheJacksonLaboratory/5baseTAPS Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input = null

    // References
    genome        = 'CHM13'
    bwamem2       = null
    fasta         = null
    fasta_fai     = null
    dict          = null
    igenomes_base = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore = false
    save_reference = false

    // MultiQC options
    multiqc_config = null
    multiqc_title = null
    multiqc_logo = null
    max_multiqc_email_size = '25.MB'
    multiqc_methods_description = null
    multiqc_replace_names = null
    multiqc_sample_names = null

    // Main options
    mode = 'rd'

    // Control genome spike-in QC (null = skip)
    lambda_fasta   = null
    lambda_fai     = null
    lambda_dict    = null
    lambda_bwamem2 = null
    puc19_fasta    = null
    puc19_fai      = null
    puc19_dict     = null
    puc19_bwamem2  = null

    // GATK variant calling — set to false to skip entirely (e.g. methylation-only runs)
    run_gatk = true

    // rastair R scripts — mbias.R, QC_report_jax.Rmd, and perChr_mbias scripts.
    // Default: bin/rastair_scripts/ inside the pipeline directory.
    // Override on CLI: --rastair_rscript_dir /path/to/scripts
    // Use container built-ins: --rastair_rscript_dir ''
    rastair_rscript_dir = null

    // Enable V-bias (per-fragment position heatmap) and GC/CpG bias plots.
    // V-bias adds ~10 GB and ~3 min to each MBIAS_CHR job.
    plot_vbias = true
    plot_gc    = true

    // Split FASTQ into N chunks for parallel alignment, then merge.
    // 1 = disabled (original single-task ALIGN_RAW_BAM). 4 recommended for 500M+ reads.
    align_raw_bam_chunks = 1

    // fgbio options
    duplex_seq = true
    // default strategy fgbio's GROUP_UMI
    groupreadsbyumi_strategy = 'Paired'
    // default number of allowable edits for fgbio's GROUP_UMI
    groupreadsbyumi_edits = 1
    // default minimum input reads for fgbio's CALL*CONSENSUSREADS tools
    call_min_reads = '1 0 0'
    // default minimum input base quality for fgbio's CALL*CONSENSUSREADS tools
    call_min_baseq = 10
    // default minimum input reads for fgbio's CONSENSUS
    filter_min_reads = '1 0 0'
    // default base quality below which reads are masked for fgbio's CONSENSUS
    filter_min_baseq = 10
    // default maximum raw-read error rate for fgbio's CONSENSUS
    filter_max_base_error_rate = 0.1

    // Boilerplate options
    outdir = null
    publish_dir_mode = 'copy'
    email = null
    email_on_fail = null
    plaintext_email = false
    monochrome_logs = false
    hook_url = null
    help = false
    help_full = false
    show_hidden = false
    version = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name = null
    config_profile_description = null

    config_profile_description = null
    config_profile_contact = null
    config_profile_url = null

    validate_params = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes = true
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false
        nextflow.enable.configProcessNamesValidation = true
    }
    sumner2_apptainer {
        includeConfig 'conf/genomes_sumner.config'
        includeConfig 'conf/sumner2_base.config'
    }
    elion2_singularity {
        includeConfig 'conf/genomes_elion.config'
        includeConfig 'conf/elion2_base.config'
    }
    sumner_test {
        includeConfig 'conf/genomes_sumner.config'
        includeConfig 'conf/sumner2_base.config'
        includeConfig 'conf/test.config'
        params.config_profile_name = 'Test profile (Sumner2)'
    }
    hpc {
        process {
            executor       = 'slurm'
            cpus           = 4
            memory         = '16 GB'
            time           = '8h'
            clusterOptions = {task.time < 72.h ? '-q batch' : '-q long'}
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = '/gt/research_development/singularity/cache'
            runOptions = '-B /gt:/gt'
        }
        executor {
            name            = 'slurm'
            queueSize       = 24
            submitRateLimit = '1 / 2 s'
        }
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        conda.channels = ['conda-forge', 'bioconda']
        apptainer.enabled = false
    }
    mamba {
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
    }
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
    }
    podman {
        podman.enabled = true
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
    }
    shifter {
        shifter.enabled = true
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
    }
    charliecloud {
        charliecloud.enabled = true
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        apptainer.enabled = false
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }
    gitpod {
        executor.name = 'local'
        executor.cpus = 4
        executor.memory = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus: 4,
                time: 1.h,
            ]
        }
    }
    test {
        includeConfig 'conf/test.config'
    }

}

// External institutional configs are not loaded by default (custom_config_base = "").
// To load a custom institutional profile, set --custom_config_base to a directory URL
// containing a nfcore_custom.config file and re-run.

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry = 'quay.io'
docker.registry = 'quay.io'
podman.registry = 'quay.io'
singularity.registry = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config unless a site profile (elion2_singularity, sumner2_singularity) is active.
// Site profiles set params.igenomes_ignore = true and supply a complete genome list themselves.
includeConfig params.igenomes_ignore ? 'conf/igenomes_ignored.config' : 'conf/igenomes.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER = "/.Rprofile"
    R_ENVIRON_USER = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail",
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name = 'TheJacksonLaboratory/5baseTAPS'
    author = """Harianto Tjong"""
    contributors = [
        [
            name: 'Harianto Tjong',
            affiliation: 'The Jackson Laboratory',
            email: 'harianto.tjong@jax.org',
            github: '',
            contribution: ['author'],
            orcid: '',
        ]
    ]
    homePage = 'https://github.com/TheJacksonLaboratory/5baseTAPS'
    description = """JAX Genomic Technologies 5-base TAPS methylation and variant calling pipeline"""
    mainScript = 'main.nf'
    defaultBranch = 'master'
    nextflowVersion = '!>=25.10.0'
    version = '1.0.0'
    doi = ''
}

// Nextflow plugins
// nf-schema: validation of pipeline parameters and creation of an input channel from a sample sheet
plugins {
    id 'nf-schema@2.7.3'
}

validation {
    lenientMode = false
    defaultIgnoreParams = ['genomes']
    monochromeLogs = params.monochrome_logs
    help {
        enabled = true
        command = "nextflow run TheJacksonLaboratory/5baseTAPS -profile <singularity/.../institute> --input samplesheet.csv --outdir <OUTDIR>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
        beforeText = """
-\033[2m------------------------------------------------------\033[0m-
\033[0;34m    888      e      Y88b    /        e88~~\\  ~~~888~~~\033[0m
\033[0;34m    888     d8b      Y88b  /        d888        888   \033[0m
\033[0;34m    888    /Y88b      Y88b/         8888 __     888   \033[0m
\033[0;34m    888   /  Y88b     /Y88b         8888   |    888   \033[0m
\033[0;34m|   88P  /____Y88b   /  Y88b        Y888   |    888   \033[0m
\033[0;34m \\__8"  /      Y88b /    Y88b        "88__/     888   \033[0m

\033[0;35m                   5baseTAPS\033[0m
-\033[2m------------------------------------------------------\033[0m-
"""
        afterText = """
* Software dependencies
    https://github.com/TheJacksonLaboratory/5baseTAPS/blob/master/CITATIONS.md
"""
    }
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
